@model IEnumerable<Member>
@{
    ViewData["Title"] = "Manage Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🧍 Manage Members</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Member</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th style="width: 220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>@member.Name</td>
                <td>@member.Email</td>
                <td>@member.Phone</td>
                <td>
                    <a asp-action="Details" asp-route-id="@member.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@member.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@member.Id" method="post" class="d-inline js-delete-confirm" data-item-name="member '@member.Name'">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
