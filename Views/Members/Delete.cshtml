@model Member
@{
    ViewData["Title"] = "Delete Member";
}

<h2>🗑 Delete Member</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this member? This will also remove their class enrollments.
</div>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Phone</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="js-delete-confirm" data-item-name="member '@Model.Name'">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
