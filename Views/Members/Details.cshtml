@model Member
@{
    ViewData["Title"] = "Member Details";
}

<h2>🧍 @Model.Name</h2>
<dl class="row">
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Phone</dd>
</dl>

<h4>Enrolled Classes (@Model.Enrollments.Count)</h4>
@if (!Model.Enrollments.Any())
{
    <div class="alert alert-info">This member is not enrolled in any classes yet.</div>
}
else
{
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Class</th>
                <th>Schedule</th>
                <th>Enrollment Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Enrollments)
            {
                <tr>
                    <td>@e.GymClass?.Name</td>
                    <td>@e.GymClass?.Schedule</td>
                    <td>@e.EnrollmentDate.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-secondary">&laquo; Back to List</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
