@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-wrapper">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h3 class="text-center mb-4">🏋 Gym Management Login</h3>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@gym.com" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>

            <hr />
            <p class="text-muted small mb-0">
                Demo Admin: <code>admin@gym.com</code> / <code>Admin123</code><br />
                Demo Trainer: <code>trainer@gym.com</code> / <code>Trainer123</code>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
