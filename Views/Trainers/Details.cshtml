@model Trainer
@{
    ViewData["Title"] = "Trainer Details";
}

<h2>🧑‍🏫 @Model.Name</h2>
<dl class="row">
    <dt class="col-sm-2">Specialization</dt>
    <dd class="col-sm-10">@Model.Specialization</dd>
</dl>

<h4>Classes taught</h4>
@if (!Model.GymClasses.Any())
{
    <div class="alert alert-info">This trainer has no classes yet.</div>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var c in Model.GymClasses)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><strong>@c.Name</strong> &mdash; @c.Schedule</span>
                <a asp-controller="GymClasses" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">View</a>
            </li>
        }
    </ul>
}

<a asp-action="Index" class="btn btn-secondary">&laquo; Back to List</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
