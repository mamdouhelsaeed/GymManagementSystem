@model Trainer
@{
    ViewData["Title"] = "Delete Trainer";
}

<h2>🗑 Delete Trainer</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this trainer? This will also delete all classes assigned to them.
</div>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Specialization</dt>
    <dd class="col-sm-10">@Model.Specialization</dd>
    <dt class="col-sm-2">Classes</dt>
    <dd class="col-sm-10">@Model.GymClasses.Count</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="js-delete-confirm" data-item-name="trainer '@Model.Name'">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
