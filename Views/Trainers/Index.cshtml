@model IEnumerable<Trainer>
@{
    ViewData["Title"] = "Manage Trainers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🧑‍🏫 Manage Trainers</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Trainer</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Specialization</th>
            <th style="width: 220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var trainer in Model)
        {
            <tr>
                <td>@trainer.Name</td>
                <td>@trainer.Specialization</td>
                <td>
                    <a asp-action="Details" asp-route-id="@trainer.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@trainer.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@trainer.Id" method="post" class="d-inline js-delete-confirm" data-item-name="trainer '@trainer.Name'">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
