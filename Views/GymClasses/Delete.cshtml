@model GymClass
@{
    ViewData["Title"] = "Delete Gym Class";
}

<h2>🗑 Delete Gym Class</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this class? This will also remove all enrollments tied to it.
</div>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Trainer</dt>
    <dd class="col-sm-10">@Model.Trainer?.Name</dd>
    <dt class="col-sm-2">Schedule</dt>
    <dd class="col-sm-10">@Model.Schedule</dd>
    <dt class="col-sm-2">Enrolled Members</dt>
    <dd class="col-sm-10">@Model.Enrollments.Count</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="js-delete-confirm" data-item-name="class '@Model.Name'">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
