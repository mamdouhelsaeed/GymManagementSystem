@model GymClass
@{
    ViewData["Title"] = "New Gym Class";
}

<h2>➕ New Gym Class</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Schedule" class="form-label"></label>
                <input asp-for="Schedule" class="form-control" placeholder="e.g. Mon/Wed/Fri 7:00 AM" />
                <span asp-validation-for="Schedule" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TrainerId" class="form-label">Trainer</label>
                <select asp-for="TrainerId" asp-items="ViewBag.TrainerId" class="form-select">
                    <option value="">-- Select Trainer --</option>
                </select>
                <span asp-validation-for="TrainerId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
